# ==========================================
# VERCEL SERVER-SIDE SECRETS (Python runtime only)
# Never expose these in client code or with VITE_ prefix!
# Configure these in Vercel Dashboard -> Settings -> Environment Variables
# ==========================================
API_SECRET_KEY="your-secure-serverless-secret-key"
WEATHER_API_KEY="optional-third-party-weather-key"
FRONTEND_ORIGINS="*"

# ==========================================
# VERCEL CLIENT-SIDE CONFIGURATION
# ==========================================
# In a unified Vercel deployment where the Python API lives at /api,
# leave VITE_API_BASE_URL empty so the browser makes same-origin relative calls to /api.
VITE_API_BASE_URL=""
